{
  "comments": {
    // Doxa line comments start with `#`. `//` is the integer-division operator,
    // not a comment.
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  // symbols used as brackets
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  // symbols that are auto closed when typing
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  // symbols that can be used to surround a selection
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  // Indent inside `{ ... }`; Doxa has no significant whitespace beyond blocks.
  "indentationRules": {
    "increaseIndentPattern": "\\{[^}]*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  // Continue block comments and keep the ` * ` gutter aligned.
  "onEnterRules": [
    {
      "beforeText": "^\\s*/\\*.*$",
      "afterText": "^\\s*\\*/\\s*$",
      "action": { "indent": "none" }
    },
    {
      "beforeText": "^\\s*/\\*.*$",
      "action": { "indent": "none", "appendText": " * " }
    },
    {
      "beforeText": "^\\s*\\*.*$",
      "action": { "indent": "none", "appendText": "* " }
    }
  ],
  // Treat `@builtin` as a single word for selection and word-based motions.
  "wordPattern": "(@?[A-Za-z_][A-Za-z0-9_]*)|([0-9]+(\\.[0-9]+)?)"
}
