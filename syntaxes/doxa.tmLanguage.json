{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Doxa",
  "scopeName": "source.doxa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#definition-function" },
    { "include": "#definition-type" },
    { "include": "#struct-instantiation" },
    { "include": "#enum-member" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.doxa",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.number-sign.doxa",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.doxa",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.doxa" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.doxa" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.doxa",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "definition-function": {
      "patterns": [
        {
          "match": "\\b(function|method)\\s+([a-zA-Z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.function.doxa" },
            "2": { "name": "entity.name.function.doxa" }
          }
        }
      ]
    },
    "definition-type": {
      "patterns": [
        {
          "match": "\\b(struct|enum|map|group)\\s+([A-Z]\\w*)",
          "captures": {
            "1": { "name": "storage.type.doxa" },
            "2": { "name": "entity.name.type.doxa" }
          }
        }
      ]
    },
    "struct-instantiation": {
      "patterns": [
        {
          "match": "(\\$)([A-Z]\\w*)",
          "captures": {
            "1": { "name": "keyword.operator.new.doxa" },
            "2": { "name": "entity.name.type.doxa" }
          }
        }
      ]
    },
    "enum-member": {
      "patterns": [
        {
          "name": "constant.other.enum.doxa",
          "match": "\\.[A-Z][a-zA-Z0-9_]*\\b(?!\\s*\\()"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.doxa",
          "match": "@[a-zA-Z_]\\w*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.doxa",
          "match": "\\b(if|iff|then|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.doxa",
          "match": "\\b(while|do|for|each|in|at)\\b"
        },
        {
          "name": "keyword.control.doxa",
          "match": "\\b(break|continue|return|returns|unreachable)\\b"
        },
        {
          "name": "keyword.operator.assignment.doxa",
          "match": "\\b(is)\\b"
        },
        {
          "name": "keyword.operator.logical.word.doxa",
          "match": "\\b(and|or|not|xor)\\b"
        },
        {
          "name": "keyword.operator.quantifier.doxa",
          "match": "\\b(where|exists|forall)\\b"
        },
        {
          "name": "keyword.control.import.doxa",
          "match": "\\b(import|module|from)\\b"
        },
        {
          "name": "keyword.other.doxa",
          "match": "\\b(to|as)\\b"
        },
        {
          "name": "storage.type.doxa",
          "match": "\\b(struct|enum|map|group|union|array)\\b"
        },
        {
          "name": "storage.type.function.doxa",
          "match": "\\b(function|method)\\b"
        },
        {
          "name": "storage.type.variable.doxa",
          "match": "\\b(var|const)\\b"
        },
        {
          "name": "storage.modifier.doxa",
          "match": "\\b(public|pub|entry)\\b"
        },
        {
          "name": "storage.modifier.inline-zig.doxa",
          "match": "\\b(zig)\\b"
        },
        {
          "name": "keyword.other.modifier.doxa",
          "match": "\\b(async|await|defer|lift)\\b"
        },
        {
          "name": "variable.language.this.doxa",
          "match": "\\b(this)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.hex.doxa",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.doxa",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.doxa",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.language.boolean.doxa",
          "match": "\\b(true|false|both|neither)\\b"
        },
        {
          "name": "constant.language.null.doxa",
          "match": "\\b(nothing)\\b"
        },
        {
          "name": "constant.language.builtin.doxa",
          "match": "\\b(PI|E|MAX_INT|MIN_INT|MAX_FLOAT|MIN_FLOAT)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.doxa",
          "match": "\\b(string|int|float|tetra|byte)\\b"
        },
        {
          "name": "entity.name.type.doxa",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.doxa",
          "match": "\\+=|-=|\\*\\*=|\\*=|/="
        },
        {
          "name": "keyword.operator.comparison.doxa",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.integer-division.doxa",
          "match": "//"
        },
        {
          "name": "keyword.operator.arithmetic.doxa",
          "match": "\\+\\+|--|\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.logical.doxa",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.type-annotation.doxa",
          "match": "::"
        },
        {
          "name": "keyword.operator.union.doxa",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.peek.doxa",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.reference.doxa",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.default.doxa",
          "match": "~"
        },
        {
          "name": "keyword.operator.logical.unicode.doxa",
          "match": "[∃∀¬↔⊕∧∨↑↓→∈]"
        },
        {
          "name": "keyword.operator.spread.doxa",
          "match": "\\.\\.\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.delimiter.doxa",
          "match": "[,;]"
        },
        {
          "name": "punctuation.section.braces.doxa",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.doxa",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.doxa",
          "match": "[()]"
        },
        {
          "name": "punctuation.accessor.dot.doxa",
          "match": "\\."
        }
      ]
    }
  }
}
