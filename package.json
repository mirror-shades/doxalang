{
  "name": "doxalang",
  "displayName": "Doxalang",
  "description": "Language support for the Doxa programming language with LSP integration",
  "version": "0.4.1-alpha",
  "publisher": "mirror-shades",
  "repository": {
    "type": "git",
    "url": "https://github.com/mirror-shades/doxalang.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:doxa",
    "onCommand:doxa.restartServer"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "which": "^4.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/node": "^20.17.6",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "languages": [{
      "id": "doxa",
      "aliases": ["Doxa", "doxa"],
      "extensions": [".doxa"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "doxa",
      "scopeName": "source.doxa",
      "path": "./syntaxes/doxa.tmLanguage.json"
    }],
    "commands": [{
      "command": "doxa.restartServer",
      "title": "Restart Language Server",
      "category": "Doxa"
    }],
    "configuration": {
      "title": "Doxa",
      "properties": {
        "doxa.serverPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Absolute path to the Doxa language-server executable. When empty, the extension looks for `doxa/bin`, `zig-out/bin`, `bin`, then `doxa` on `PATH`. Accepts a workspace-relative path."
        },
        "doxa.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "scope": "window",
          "markdownDescription": "Trace the communication between VS Code and the Doxa language server. Written to the **Doxa LSP Trace** output channel."
        }
      }
    },
    "configurationDefaults": {
      "[doxa]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
      }
    }
  }
}
